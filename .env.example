# Groleads MCP — Google Maps targeting

# --- Magileads auth: choose ONE method ---
# Option A (preferred): a Magileads API key, sent as X-API-Key.
MAGILEADS_API_KEY=
# Option B: email + password login (JWT, auto-refreshed).
# MAGILEADS_EMAIL=you@example.com
# MAGILEADS_PASSWORD=
# Optional: override the API base URL (defaults to https://app.api-magileads.net).
# MAGILEADS_API_BASE=https://app.api-magileads.net

# --- HTTP transport (node dist/http.js — used for the Docker / remote deployment) ---
# REQUIRED in HTTP mode: the bearer token clients must send.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional:
# MCP_HTTP_PORT=8080
# MCP_HTTP_PATH=/mcp

# (The stdio transport — node dist/index.js — needs none of the MCP_* vars.)
