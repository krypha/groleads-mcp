# HTTP authentication: oauth (default), api_key, or both.
# api_key does not need any OAUTH_* values. For both, fill all five below.
# Never commit .env.
# MCP_HTTP_AUTH=oauth
# MCP_ALLOW_API_KEY_QUERY=false

# Required when MCP_HTTP_AUTH=oauth or both.
# Fill from the Magileads authorization-server deployment.
OAUTH_ISSUER=
OAUTH_MCP_RESOURCE=
OAUTH_API_RESOURCE=
OAUTH_INTERNAL_CLIENT_ID=
OAUTH_INTERNAL_CLIENT_SECRET=

# Optional HTTP overrides.
# MAGILEADS_API_URL=https://api.example.com
# OAUTH_JWKS_URI=https://auth.example.com/jwks
# OAUTH_CLOCK_TOLERANCE=60
# MCP_HTTP_PORT=8080
# MCP_HTTP_PATH=/mcp

# API-key HTTP requests and stdio use this API base (default shown below).
# MAGILEADS_API_BASE=https://app.api-magileads.net

# Separate stdio mode only: one Magileads account from the environment.
# MAGILEADS_API_KEY=
# MAGILEADS_EMAIL=
# MAGILEADS_PASSWORD=
