# HTTP authentication: oauth (default), api_key, or both.
# api_key does not need any OAUTH_* values. For both, fill all five below.
# Never commit .env.
# MCP_HTTP_AUTH=oauth
# MCP_ALLOW_API_KEY_QUERY=false

# Required when MCP_HTTP_AUTH=oauth or both.
# Fill from the Magileads authorization-server deployment.
# Issuer normally https://app.api-magileads.net; must match discovery/JWT iss exactly.
# MCP resource = canonical public URL including /mcp, also registered on the API.
# API resource = audience authorized by the API team (not automatically its base URL).
# Internal credentials = confidential client authorized for token-exchange, NOT
# the public client returned by /oauth/register (authorization_code/refresh_token).
OAUTH_ISSUER=
OAUTH_MCP_RESOURCE=
OAUTH_API_RESOURCE=
OAUTH_INTERNAL_CLIENT_ID=
OAUTH_INTERNAL_CLIENT_SECRET=

# Optional HTTP overrides.
# MAGILEADS_API_URL=https://api.example.com
# OAUTH_JWKS_URI=https://app.api-magileads.net/oauth/jwks.json
# JWKS override is optional; token_endpoint is ALWAYS resolved through discovery.
# OAUTH_CLOCK_TOLERANCE=60
# MCP_HTTP_PORT=8080
# MCP_HTTP_PATH=/mcp
# MCP_TOOL_PROFILE=public  # public plugin: 23 dedicated tools, including create_email_model
# MCP_TOOL_PROFILE=full    # default: all 26 tools, including guarded business API passthrough
# Only for public OpenAI Plugins Directory submission: exact one-time token
# supplied by the portal for https://<MCP-host>/.well-known/openai-apps-challenge.
# OPENAI_APPS_CHALLENGE_TOKEN=

# API-key HTTP requests and stdio use this API base (default shown below).
# MAGILEADS_API_BASE=https://app.api-magileads.net

# Separate stdio mode only: one Magileads account from the environment.
# MAGILEADS_API_KEY=
# MAGILEADS_EMAIL=
# MAGILEADS_PASSWORD=
