{
  "name": "@groleads/mcp-google-maps",
  "version": "0.5.0",
  "description": "MCP server exposing Groleads (Magileads) Google Maps targeting as tools for AI agents. Stdio + HTTP transports. No LinkedIn account required.",
  "type": "module",
  "bin": {
    "groleads-mcp-google-maps": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc && node dist/index.js",
    "dev:http": "tsc && node dist/http.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.13",
    "typescript": "^5.5.4"
  }
}
