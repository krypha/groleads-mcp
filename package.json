{
  "name": "@groleads/mcp-google-maps",
  "version": "0.7.0",
  "description": "MCP server exposing Groleads (Magileads) targeting, contact, campaign-audit, PRM and generic API tools for AI agents. Runs on Bun. Stdio + HTTP transports.",
  "type": "module",
  "bin": {
    "groleads-mcp-google-maps": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/http.ts --target bun --outdir dist",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/http.ts",
    "dev": "bun run src/index.ts",
    "dev:http": "bun run src/http.ts",
    "typecheck": "tsc --noEmit",
    "gen:endpoints": "bun run scripts/generate-endpoints.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.13",
    "typescript": "^5.5.4"
  }
}
