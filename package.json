{
  "name": "magileads-mcp",
  "version": "0.10.0",
  "description": "Magileads MCP — exposes Magileads (targeting, contact lists, campaign audit, PRM, and all OpenAPI endpoints except DELETE) as tools for AI agents. Runs on Bun. Stdio + HTTP transports.",
  "type": "module",
  "bin": {
    "magileads-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/http.ts --target bun --outdir dist",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/http.ts",
    "dev": "bun run src/index.ts",
    "dev:http": "bun run src/http.ts",
    "typecheck": "tsc --noEmit",
    "gen:endpoints": "bun run scripts/generate-endpoints.mjs",
    "tools:table": "bun run scripts/tool-table.ts",
    "test:oauth": "bun test tests/oauth.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.2.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.13",
    "typescript": "^5.5.4"
  }
}
